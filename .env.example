# Copy to .env.local and fill in from your Supabase project (Settings > API),
# or from `npx supabase status` when running the local stack.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Public origin used in auth emails (magic links, confirmations).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server only. Never prefix with NEXT_PUBLIC_. Used to record evidence after the
# server has hashed the uploaded file. `npx supabase status` shows it as SECRET_KEY.
SUPABASE_SECRET_KEY=
# Optional. Name of a transcription provider registered in
# src/lib/transcripts/provider.ts. Leave empty to use transcript import only.
TRANSCRIPTION_PROVIDER=
# Reminder emails (Phase 4). Server only.
RESEND_API_KEY=
REMINDER_FROM_EMAIL="Evidence Locker <reminders@your-domain.example>"
# Random string; Vercel Cron sends it as a bearer token to /api/cron/reminders.
CRON_SECRET=
# Payments (Phase 5). Leave STRIPE_PRICE_ID empty to keep every feature unlocked.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# "payment" (one-off unlock, default) or "subscription".
STRIPE_MODE=payment
# Shown on the Plans page, e.g. "£19 one-off".
NEXT_PUBLIC_PRICE_LABEL=
# Launch hardening (Phase 6). Optional until configured; see docs/launch-checklist.md.
VIRUS_SCAN_URL=
VIRUS_SCAN_TOKEN=
ERROR_WEBHOOK_URL=
